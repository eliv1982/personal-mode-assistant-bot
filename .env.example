# ── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Price per 1 million tokens (USD). Check https://openai.com/pricing for current rates.
OPENAI_INPUT_PRICE_PER_1M=0.15
OPENAI_OUTPUT_PRICE_PER_1M=0.60

# ── Memory ───────────────────────────────────────────────────────────────────
# Maximum number of individual messages (user + assistant, counted separately,
# not as pairs) to keep per chat. Must be an even number >= 2.
MEMORY_LIMIT=20

# ── Exchange rate fallback ────────────────────────────────────────────────────
# Used when CBR XML endpoint is unavailable
USD_RUB_FALLBACK=100.0

# ── Access control (optional) ────────────────────────────────────────────────
# Comma-separated Telegram chat IDs allowed to send paid LLM requests.
# Leave empty/unset to allow every chat (current default behavior).
ALLOWED_CHAT_IDS=
